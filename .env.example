# Example Environment Variables Template for Power Grid Fault Localization System (FLASH)

# Optional: Groq LLM API Key for on-demand "Explain this fault" feature
# Get a free API key at https://console.groq.com
# If omitted or empty, core system operates with 100% functionality and graceful AI fallback.
GROQ_API_KEY=gsk_your_groq_api_key_here

# PostgreSQL database connection string (used inside Docker Compose)
DATABASE_URL=postgresql+psycopg2://postgres:hellosql@db:5432/power_grid_db

# Enable SQLAlchemy query logging (true/false)
SQL_ECHO=false

# Frontend API base URL (baked into Vite bundle at build time)
VITE_API_BASE_URL=http://localhost:8000
