# Copy to .env before running `docker compose up`.

# Groq API key for the AI root-cause/summary feature. Get a free one
# at https://console.groq.com. Everything except the AI "explain"
# button works without it.
GROQ_API_KEY=

# Only change this if the backend won't be reachable at
# http://localhost:8000 from wherever the frontend is served (e.g.
# a non-local deployment). Baked into the frontend at build time.
VITE_API_BASE_URL=http://localhost:8000
